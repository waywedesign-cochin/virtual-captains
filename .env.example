# Copy to .env.local and fill in the values. Never commit .env.local.

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-15

# Public site URL (canonical links, sitemap, share cards)
NEXT_PUBLIC_SITE_URL=https://virtualcaptains.vercel.app

# Razorpay — server-side only, never expose the secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# true = every page except Home redirects to /under-development
NEXT_PUBLIC_UNDER_DEVELOPMENT=false
