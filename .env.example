# Copy to .env.local and fill in the values. Never commit .env.local.

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-15

# Public site URL (canonical links, sitemap, share cards)
NEXT_PUBLIC_SITE_URL=https://virtualcaptains.vercel.app

# Razorpay — server-side only, never expose the secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend — email for every site form (server-side only)
RESEND_API_KEY=
# Verified sender, e.g. "Virtual Captains <hello@yourdomain.com>"
APPLICATIONS_FROM_EMAIL=
# Team inbox(es), comma-separated. Used by every form unless overridden below.
APPLICATIONS_TO_EMAIL=
# Optional per-form inboxes (fall back to APPLICATIONS_TO_EMAIL)
CONTACT_TO_EMAIL=
CAREERS_TO_EMAIL=
PARTNER_TO_EMAIL=
# Resend Audience IDs: "Notify me" (batch openings) and the blog newsletter
RESEND_AUDIENCE_NOTIFY=
RESEND_AUDIENCE_NEWSLETTER=
# Random secret that signs email verification codes (Book a Call)
VERIFY_SECRET=

# true = every page except Home redirects to /under-development
NEXT_PUBLIC_UNDER_DEVELOPMENT=false
